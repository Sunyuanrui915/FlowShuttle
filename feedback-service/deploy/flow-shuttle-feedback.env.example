FLOW_FEEDBACK_DATA_DIR=/var/lib/flow-shuttle-feedback
FLOW_FEEDBACK_PUBLIC_BASE_URL=https://www.sunyuanrui.com
FLOW_FEEDBACK_PUBLIC_PATH=/api/flow-shuttle/feedback
FLOW_FEEDBACK_TOKEN_SECRET=replace-with-a-random-server-only-value
FLOW_FEEDBACK_TOKEN_TTL_SECONDS=604800

FLOW_FEEDBACK_SMTP_ENABLED=false
FLOW_FEEDBACK_SMTP_HOST=smtp.qq.com
FLOW_FEEDBACK_SMTP_PORT=465
FLOW_FEEDBACK_SMTP_SECURITY=ssl
FLOW_FEEDBACK_SMTP_USERNAME=
FLOW_FEEDBACK_SMTP_PASSWORD=
FLOW_FEEDBACK_SMTP_FROM=
FLOW_FEEDBACK_RECIPIENT=

FLOW_FEEDBACK_OUTBOX_POLL_SECONDS=15
FLOW_FEEDBACK_MAX_EMAIL_ATTEMPTS=8
FLOW_FEEDBACK_RETENTION_DAYS=180
FLOW_FEEDBACK_RETENTION_CHECK_SECONDS=86400
FLOW_FEEDBACK_RATE_LIMIT_REQUESTS=6
FLOW_FEEDBACK_RATE_LIMIT_FAILURES=4
FLOW_FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=600
